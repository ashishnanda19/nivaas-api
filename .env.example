NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nivaas:nivaas@localhost:5432/nivaas
# Optional. Without it the app uses an in-process scheduler.
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:5173
# Comma-separated phones that accept the fixed OTP 123456 even in production (seeded demo accounts only).
DEMO_OTP_PHONES=
# Dev only: accept the fixed OTP 123456 for every number. Must be false in production.
OTP_FIXED_CODE_ENABLED=true
# Text messages. console records that a message was sent and delivers nothing; twilio delivers for real.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=91
# A real provider texts only these numbers (comma separated), never the demo accounts. SMS_ALLOW_ALL=true lifts the list on purpose.
SMS_ALLOWED_PHONES=
SMS_ALLOW_ALL=false
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
STORAGE_DIR=./storage
# local (disk) or db (Postgres). An S3_BUCKET below overrides both.
STORAGE_DRIVER=local
# Optional S3-compatible object storage (Supabase Storage, Cloudflare R2, AWS S3). Leave S3_BUCKET empty to keep files on local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
