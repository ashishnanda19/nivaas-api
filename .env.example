NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nivaas:nivaas@localhost:5432/nivaas
# Optional. Without it the app uses an in-process scheduler.
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:5173
# Dev only: accept the fixed OTP 123456. Must be false in production.
DEMO_OTP_PHONES=
OTP_FIXED_CODE_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
STORAGE_DIR=./storage
# Optional S3-compatible object storage (Supabase Storage, Cloudflare R2, AWS S3). Leave S3_BUCKET empty to keep files on local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
