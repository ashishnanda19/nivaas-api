NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nivaas:nivaas@localhost:5432/nivaas
# Optional. Without it the app uses an in-process scheduler.
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:5173
# Dev only: accept the fixed OTP 123456. Must be false in production.
OTP_FIXED_CODE_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
STORAGE_DIR=./storage
